# Copy to `.env` or `.env.local` for local development.
#
# CRITICAL for production: set `VITE_API_URL` in your hosting provider (Vercel)
# at *build* time to your backend origin — NOT the static site URL.
#
# Production (CallsFlow):
#   VITE_API_URL=https://api.callsflow.io
#
# DNS cutover to a new VPS does NOT require changing this URL if the hostname stays the same.
# Redeploy only if the env var was wrong.
#
# If missing, the app will fetch `/api/...` from the CDN and receive HTML instead of JSON.
# Hostnames without https:// are normalized to https:// (e.g. api.example.com → https://api.example.com).
# In dev, if unset, defaults to http://localhost:3001.

VITE_API_URL=http://localhost:3001

# Calendly booking URL for the landing page scheduler.
# VITE_CALENDLY_URL=https://calendly.com/your-org/meeting

# Sentry (frontend error monitoring).
# VITE_SENTRY_DSN is inlined at *build* time — set it in your hosting provider
# (Vercel) and redeploy for it to take effect. Without it, Sentry is a no-op.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production

# Source map upload (build-time only — set these in the Vercel build env, NOT the client).
# When SENTRY_AUTH_TOKEN is present, the build uploads + deletes source maps so
# production stack traces are readable. Create the token as a Sentry internal integration.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...

# Backend uses SENTRY_DSN (set in the backend host env, see backend Sentry config).
