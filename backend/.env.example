# CallsFlow backend — environment template
# Copy to `.env` on the server. Never commit real secrets.
#
# Production API hostname stays: https://api.callsflow.io
# See backend/deploy/OPS_RUNBOOK.md for cutover / deploy / rollback.

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Public URLs (must match DNS — do not invent a new API host) ─────────────
API_BASE_URL=https://api.callsflow.io
VOICE_WEBHOOK_BASE_URL=https://api.callsflow.io

# CORS allowlist (comma-separated). www/apex variants are auto-expanded.
CLIENT_URLS=https://callsflow.io,https://www.callsflow.io
# Stripe checkout redirects + referral base
CLIENT_URL=https://www.callsflow.io
# Optional override for post-signup dashboard links
# APP_DASHBOARD_URL=https://www.callsflow.io/app

# ─── Redis (Upstash) — required for multi-node / production ──────────────────
REDIS_URL=rediss://default:PASSWORD@YOUR_UPSTASH_HOST:6379
# Leave empty on production. Use e.g. staging: when staging shares the same DB.
# REDIS_KEY_PREFIX=
# Fail-fast without Redis adapter when NODE_ENV=production (override only for local single-process):
# REQUIRE_REDIS_ADAPTER=true

# ─── Firebase Admin (pick ONE style) ─────────────────────────────────────────
# Style A — JSON blob (preferred on VPS):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Style B — discrete fields:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_PRIVATE_KEY_BASE64=
FIREBASE_STORAGE_BUCKET=
# FIRESTORE_DATABASE_ID=default

# ─── Firebase Web config (served to SPA via GET /api/public/firebase-config) ─
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
# Mirror CLIENT_URLS (and stage if used)
FIREBASE_CONFIG_ALLOWED_ORIGINS=https://callsflow.io,https://www.callsflow.io

# ─── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
# TWILIO_ACA_PHONE_NUMBER=
TWILIO_VALIDATE_WEBHOOKS=true
# CALL_QUEUE_MAX_ATTEMPTS=12

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dashboard webhook URL: https://api.callsflow.io/api/stripe/webhook

# ─── SMTP (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SUPPORT_TO_EMAIL=admin@callsflow.io
# ADMIN_SIGNUP_NOTIFY_EMAIL=admin@callsflow.io

# ─── Sentry (backend) ────────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENABLE_PROFILING=false
# SENTRY_ENABLE_LOGS=true
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1

# ─── AI / QA ─────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# (gemini-2.5-flash is blocked for new API keys — use 3.5-flash-lite or gemini-3.5-flash)
# Two separate Gemini features:
#   QA insight (call-score) — off by default
#   AI Flags (recording compliance) — on by default
# QA_INSIGHT_GEMINI_ENABLED=false
# AI_FLAGS_GEMINI_ENABLED=true
# AI Flags only analyzes calls whose duration is campaign buffer + EXTRA_MIN … buffer + EXTRA_MAX
# (e.g. 90s buffer → 100–105s). Applied on every call end and on manual catch-up.
# AI_FLAGS_BUFFER_EXTRA_MIN_SEC=10
# AI_FLAGS_BUFFER_EXTRA_MAX_SEC=15
# Free-tier tip: catch-up 1 call at a time from Admin → AI Flags. Rate limits are per request.
# Audio QA / AI Flags uses the same Gemini key. Recordings are fetched from Twilio and sent to Gemini.
# End-of-shift auto review (optional; prefer per-call trigger above):
# QA_AUTO_SHIFT_ENABLED=false
# QA_AUTO_SHIFT_IDLE_MS=300000
# QA_AUTO_SHIFT_POLL_MS=30000
# QA_AUTO_BATCH_LIMIT=40
# QA_SHIFT_TIMEZONE=America/New_York

# ─── Release stamping (optional CI) ──────────────────────────────────────────
# RELEASE_STAMP_TOKEN=
# RELEASE_ID=

# ─── Meta Conversions (optional) ─────────────────────────────────────────────
# META_PIXEL_ID=
# META_DATASET_ID=
# META_ACCESS_TOKEN=
# META_GRAPH_VERSION=v21.0

# ─── Rate limits (optional; defaults are in middleware/security.js) ───────────
# Per-process in-memory. With PM2 instances:2 the effective cap is roughly 2×.
# RATE_LIMIT_GLOBAL_MAX=2000
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
